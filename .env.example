# Kopieren nach .env und anpassen:  cp .env.example .env

# Port auf dem Server (nur für Zugriff ohne Tunnel nötig)
HOST_PORT=8085
# 127.0.0.1 = nur vom Server selbst erreichbar (empfohlen mit Cloudflare Tunnel)
# 0.0.0.0   = auch im Heimnetz erreichbar
HOST_BIND=127.0.0.1

# Optionales App-Passwort. Mit Cloudflare Access leer lassen.
APP_PASSWORD=

# Token des Cloudflare Tunnels (Zero Trust → Networks → Tunnels → Tunnel → Install connector)
TUNNEL_TOKEN=
